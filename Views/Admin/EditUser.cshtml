@model TaskManager.Models.ApplicationUser
@{
    ViewData["Title"] = "Edit User";
}

<div class="page-header">
    <h1 class="page-title">Edit User</h1>
</div>

<div class="card">
    <form asp-action="EditUser" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        
        <div class="form-group mb-3">
            <label class="form-label">Email</label>
            <input type="text" class="form-control" value="@Model.Email" disabled />
        </div>

        <div class="form-group mb-3">
            <label for="role" class="form-label">Role</label>
            <select name="role" asp-items="Html.GetEnumSelectList<Role>()" class="form-control">
                <option value="@Model.Role" selected>@Model.Role</option>
            </select>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Users" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
</div>

