@model IEnumerable<TaskManager.Models.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="page-title">User Management</h1>
        </div>
        <a asp-action="CreateUser" class="btn btn-primary">Create New User</a>
    </div>
</div>

@await Html.PartialAsync("_Messages")

<div class="table-container">
    <table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    <span class="role-badge role-@user.Role.ToString().ToLower()">@user.Role</span>
                </td>
                <td>
                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Edit</a>
                    @if (user.Id != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                    {
                        <form asp-action="DeleteUser" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
    </table>
</div>

