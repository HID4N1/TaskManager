<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskManager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-container">
            <!-- Top Navigation Bar -->
            <nav class="top-navbar">
                <a class="app-name" asp-controller="Home" asp-action="Index">TaskManager</a>
                <div class="user-info">
                    @{
                        var userRole = "MEMBER";
                        if (User.IsInRole("ADMIN")) { userRole = "ADMIN"; }
                        else if (User.IsInRole("MANAGER")) { userRole = "MANAGER"; }
                    }
                    <span class="user-name">@User.Identity.Name</span>
                    <span class="role-badge role-@userRole.ToLower()">@userRole</span>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-secondary btn-sm">Logout</button>
                    </form>
                </div>
            </nav>

            <!-- Left Sidebar -->
            <aside class="sidebar">
                <ul class="sidebar-nav">
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link" asp-controller="Project" asp-action="Index">
                            Dashboard
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link" asp-controller="Project" asp-action="Index">
                            Projects
                        </a>
                    </li>
                    @if (User.IsInRole("ADMIN") || User.IsInRole("MANAGER"))
                    {
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-controller="Task" asp-action="Index">
                                All Tasks
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("ADMIN") || User.IsInRole("MANAGER"))
                    {
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-controller="Report" asp-action="Index">
                                Reports
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("ADMIN"))
                    {
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link" asp-controller="Admin" asp-action="Users">
                                Admin
                            </a>
                        </li>
                    }
                </ul>
            </aside>

            <!-- Main Content -->
            <main class="main-content">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <!-- Auth Pages Layout (No Sidebar) -->
        <div>
            <nav class="top-navbar">
                <a class="app-name" asp-controller="Home" asp-action="Index">TaskManager</a>
                <div class="user-info">
                    <a class="btn btn-secondary btn-sm" asp-controller="Auth" asp-action="Login">Login</a>
                    <a class="btn btn-primary btn-sm" asp-controller="Auth" asp-action="Signup">Sign Up</a>
                </div>
            </nav>
            <div class="auth-content-wrapper">
                @RenderBody()
            </div>
        </div>
    }

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
