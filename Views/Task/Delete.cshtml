@model TaskManager.Models.TaskItem
@{
    ViewData["Title"] = "Delete Task";
}

<div class="page-header">
    <h1 class="page-title">Delete Task</h1>
</div>

<div class="card">
    <p class="delete-confirmation-text">Are you sure you want to delete this task?</p>
    <dl class="details-grid">
        <dt>Title</dt>
        <dd>@Model.Title</dd>
        <dt>Project</dt>
        <dd>@Model.Project?.Name</dd>
    </dl>
    <div class="action-buttons">
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
        <a asp-action="Kanban" asp-route-projectId="@Model.ProjectId" class="btn btn-secondary">Cancel</a>
    </div>
</div>

