@model TaskManager.ViewModels.TaskViewModel
@{
    ViewData["Title"] = "Create Task";
}

<div class="page-header">
    <h1 class="page-title">Create Task</h1>
</div>

<div class="card">
    <form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    
    <input type="hidden" asp-for="ProjectId" />

    <div class="form-group mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Priority>()" class="form-control"></select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<TaskStatus>()" class="form-control"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ProjectId" class="form-label">Project</label>
        <select asp-for="ProjectId" class="form-control">
            @if (ViewBag.Projects != null)
            {
                @foreach (var project in ViewBag.Projects as IEnumerable<TaskManager.Models.Project>)
                {
                    <option value="@project.Id">@project.Name</option>
                }
            }
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="AssignedUserId" class="form-label">Assign To Member</label>
        <select asp-for="AssignedUserId" class="form-control">
            <option value="">-- Unassigned --</option>
            @if (ViewBag.Users != null)
            {
                @foreach (var user in ViewBag.Users as IEnumerable<TaskManager.Models.ApplicationUser>)
                {
                    <option value="@user.Id">@user.Email</option>
                }
            }
        </select>
        <small class="form-text text-muted">Select a team member (MEMBER role) to assign this task to.</small>
        <span asp-validation-for="AssignedUserId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" type="date" class="form-control" />
        <span asp-validation-for="DueDate" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="EstimatedHours" class="form-label"></label>
        <input asp-for="EstimatedHours" type="number" step="0.1" class="form-control" />
        <span asp-validation-for="EstimatedHours" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="RealHours" class="form-label"></label>
        <input asp-for="RealHours" type="number" step="0.1" class="form-control" />
        <span asp-validation-for="RealHours" class="text-danger"></span>
    </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Kanban" asp-route-projectId="@Model.ProjectId" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

