@model IEnumerable<TaskManager.Models.Report>
@{
    ViewData["Title"] = "Reports";
}

<div class="page-header">
    <h1 class="page-title">Reports</h1>
    <p class="page-subtitle">View and generate project reports</p>
</div>

<div class="mb-3">
    <a asp-action="TaskByStatus" class="btn btn-primary">Task Count by Status (All Projects)</a>
</div>

<div class="card">
    <div class="card-header">Generated Reports</div>
    <div class="table-container">
        <table class="table">
    <thead>
        <tr>
            <th>Type</th>
            <th>Period</th>
            <th>Generated At</th>
            <th>Generated By</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var report in Model)
        {
            <tr>
                <td>@report.Type</td>
                <td>@report.Period</td>
                <td>@report.GeneratedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@report.GeneratedBy?.Email</td>
            </tr>
        }
    </tbody>
        </table>
    </div>
</div>

